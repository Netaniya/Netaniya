# Optional live calls: all four settings are required. No key is needed for evaluation.
# Export variables in your shell; .env is NOT automatically loaded.
QUALITY_LAB_ENABLE_LIVE=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Generate a separate random access token: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUALITY_LAB_GENERATION_TOKEN=
# Per-process cap; failed calls count, no automatic retries. Account spend limits are separate.
QUALITY_LAB_MAX_CALLS_PER_HOUR=20
