{
  "version": 1,
  "id": "business-de-v1",
  "language": "de",
  "provenance": "handwritten_illustrative_samples",
  "cases": [
    {
      "id": "T01",
      "title": "JSON statt Freitext",
      "category": "structure",
      "prompt": "Extrahiere die Rechnung als JSON mit exakt zwei Feldern: id (String), total_eur (Zahl). Rechnung DEMO-104, Betrag 149 Euro.",
      "weight": 2,
      "checks": [
        {
          "op": "json_valid"
        },
        {
          "op": "json_keys",
          "value": [
            "id",
            "total_eur"
          ]
        },
        {
          "op": "json_field",
          "field": "id",
          "value": "DEMO-104"
        },
        {
          "op": "json_field",
          "field": "total_eur",
          "value": 149
        }
      ],
      "outputs": {
        "a": "Rechnung DEMO-104, Betrag: 149 Euro.",
        "b": "{\"id\":\"DEMO-104\",\"total_eur\":149}"
      }
    },
    {
      "id": "T02",
      "title": "Anfrage richtig zuordnen",
      "category": "accuracy",
      "prompt": "Ordne die Nachricht einer Kategorie zu: billing, delivery oder other. Antworte nur mit der Kategorie. Nachricht: Ich habe eine Frage zu meiner Rechnung.",
      "weight": 1,
      "checks": [
        {
          "op": "exact_text",
          "value": "billing"
        }
      ],
      "outputs": {
        "a": "billing",
        "b": "billing"
      }
    },
    {
